# Example environment variables for Hacky Pizza POS backend
# Copy this file to .env (do NOT commit real .env with secrets)

# MongoDB Atlas connection string (DO NOT include angle brackets)
# Example (recommended to include database name `restosync`):
# MONGO_URI=mongodb+srv://spinadmin:AmanAmanKumar@cluster0.uabkidw.mongodb.net/restosync?retryWrites=true&w=majority&appName=Cluster0
# Replace the username/password with your Atlas DB user credentials.
# Do NOT include the literal characters < or > in the URI.
# If the password contains special characters, percent-encode them.
MONGO_URI=MONGO_URI=mongodb+srv://spinadmin:AmanAmanKumar@cluster0.uabkidw.mongodb.net/restosync?retryWrites=true&w=majority&appName=Cluster0

# Port the backend will listen on (Render provides PORT automatically)
PORT=4000

# Optional: restrict CORS to your frontend URL (set to '*' for development/testing)
FRONTEND_URL=

# Node environment
NODE_ENV=development

# Important: After creating .env, run the server with these env vars available.
# For local testing (PowerShell):
#   Copy-Item .env.example .env
#   Then edit .env to fill values.
# Or create .env using a text editor and paste the exact MONGO_URI (no surrounding quotes).
